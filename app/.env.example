# Vercel > Project > Settings > Environment Variables. Nothing here is a wallet key.

# The live site address (link previews).
NEXT_PUBLIC_SITE_URL=https://stockcall.fun

# Upstash Redis for the sealed-reveal inbox (Vercel > Storage > Upstash Redis sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A long random string. Put the same value in the GitHub repo secret REVEAL_INBOX_TOKEN, and set the repo secret
# REVEAL_INBOX_URL to https://<your site>/api/reveals, so only the keeper can read the inbox.
REVEAL_INBOX_TOKEN=

# Optional: a private Robinhood Chain RPC for the inbox's on-chain checks.
ROBINHOOD_RPC_URL=

# After the Pons launch: the $CALL address, shown with copy and buy buttons.
NEXT_PUBLIC_CALL_CA=
# Once the X account exists.
NEXT_PUBLIC_X_URL=
