# Copy to launch.env and fill in. Addresses and names only: never put a private key in this file.

# Admin: proposes and executes every change, each one after 48 hours. A Safe on app.safe.global, or a plain
# MetaMask wallet (then set ALLOW_PLAIN_WALLETS=1 and ADMIN_ACCOUNT below).
ADMIN_MULTISIG=0x...
# Guardian: can only pause and lower limits. A second Safe or a different plain wallet.
GUARDIAN_MULTISIG=0x...
# 1 = admin and guardian are plain wallets, not Safes.
ALLOW_PLAIN_WALLETS=0
# Plain-wallet admin only: the name you gave it in node tools/import-key.js <name>, used by --schedule/--execute.
ADMIN_ACCOUNT=
# Written for you by: node tools/wallet.js keeper-secret
KEEPER_ADDRESS=0x...
# The name you gave the dev wallet in: node tools/import-key.js <name>
DEPLOYER_ACCOUNT=stockcall-dev
# Leave empty: the protocol deploys first, and ./set-token.sh adds $CALL after the Pons launch.
CALL_TOKEN_ADDRESS=
# Optional private RPC (for example Alchemy) if the public one drops connections. Remove the # to use it.
#ROBINHOOD_RPC_URL=
